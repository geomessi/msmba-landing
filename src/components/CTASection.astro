---
import type { Variant } from "../data/content";
import { sentenceLines } from "../lib/type";
import WaitlistForm from "./WaitlistForm.astro";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { hero } = variant;
---

<section id="waitlist" class="relative overflow-hidden bg-ink px-5 py-24 sm:px-8 sm:py-32">
	<!-- Same drifting wash as the problem section, so the two dark bookends of
		 the page feel like one continuous surface. -->
	<div class="aurora pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>
	<span
		class="rule-glide pointer-events-none absolute inset-x-0 top-0 h-0.5"
		aria-hidden="true"></span>

	<div class="relative mx-auto max-w-[1400px]">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-end lg:gap-20">
			<div>
				<p class="eyebrow flex items-center gap-3 text-white/45">
					<span class="h-px w-8 bg-white/30" aria-hidden="true"></span>
					{hero.ctaKind === "waitlist" ? "Join the waitlist" : "Request an info session"}
				</p>
				<h2 class="mt-7 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.04] text-white [text-wrap:pretty]">
					{
						sentenceLines(hero.headlineLead).map((line) => (
							<span class="block font-display font-extrabold tracking-[-0.03em]">{line}</span>
						))
					}
					<span class="mt-1 block font-editorial italic">{hero.headlineEmphasis}</span>
				</h2>
			</div>

			<div class="lg:pb-3">
				<p class="mb-8 max-w-md text-lg leading-relaxed text-white/65">
					Leave your email and we will send program details and the application timeline.
				</p>
				<WaitlistForm variant={variant} placement="cta" />
			</div>
		</div>
	</div>
</section>
