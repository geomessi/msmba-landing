---
import { UNIVERSAL_FAQ } from "../data/content";
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme, objections } = variant;

// ICP-specific questions first (most relevant to this reader), universal program
// facts after — all rendered as plain text in the body per PRD 5.4 (no PDFs/modals).
const faqs = [...objections, ...UNIVERSAL_FAQ];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: { "@type": "Answer", text: item.answer },
	})),
};
---

<section class="px-6 py-16 sm:py-20" id="faq">
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<div class="mx-auto max-w-2xl">
		<h2 class={`${theme.headingFont} text-2xl font-bold sm:text-3xl`}>Frequently Asked Questions</h2>
		<div class="mt-8 divide-y divide-black/10 border-t border-b border-black/10">
			{
				faqs.map((item) => (
					<details class="faq-item group py-4" data-question={item.question}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-black/90">
							{item.question}
							<span class="shrink-0 text-black/40 transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-black/70">{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<script>
	import { track } from "../lib/track";

	document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((details) => {
		details.addEventListener(
			"toggle",
			() => {
				if (!details.open) return;
				track("faq_expand", { question: details.dataset.question ?? "" });
			},
			{ once: true },
		);
	});
</script>
