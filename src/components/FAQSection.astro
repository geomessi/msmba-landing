---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme } = variant;

// Order is set per variant in the data, so the section reads as a sequence.
// All answers sit in plain body text per PRD 5.4, no PDFs and no modals, so
// answer engines can quote them directly.
const faqs = variant.faqs;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: { "@type": "Answer", text: item.answer },
	})),
};
---

<section id="faq" class={`rule-glide border-t ${theme.rule} px-5 py-20 sm:px-8 sm:py-24`}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<div class="mx-auto max-w-[1400px]">
		<div class="grid gap-8 lg:grid-cols-[10rem_1fr] lg:gap-20">
			<p class="eyebrow shrink-0 text-ink-muted lg:pt-5">FAQ</p>

			<div class="max-w-3xl">
				<h2 class="font-editorial text-section leading-[1.15] text-balance text-ink">
					Frequently Asked Questions
				</h2>

				<div class={`mt-10 border-t ${theme.rule}`}>
					{
						faqs.map((item) => (
							<details class={`faq-item group border-b ${theme.rule}`} data-question={item.question}>
								<summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6">
									<span class="font-editorial text-xl leading-snug text-ink sm:text-[1.5rem]">
										{item.question}
									</span>
									{/* Plus rotating into a minus */}
									<span
										class="relative mt-2.5 h-3.5 w-3.5 shrink-0 text-crimson transition-transform duration-300 group-open:rotate-45"
										aria-hidden="true"
									>
										<span class="absolute top-1/2 left-0 h-[1.5px] w-full -translate-y-1/2 bg-current" />
										<span class="absolute top-0 left-1/2 h-full w-[1.5px] -translate-x-1/2 bg-current" />
									</span>
								</summary>
								<p class="max-w-2xl pr-10 pb-7 text-lg leading-relaxed text-ink-soft">{item.answer}</p>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { track } from "../lib/track";

	document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((details) => {
		details.addEventListener(
			"toggle",
			() => {
				if (!details.open) return;
				track("faq_expand", { question: details.dataset.question ?? "" });
			},
			{ once: true },
		);
	});
</script>
