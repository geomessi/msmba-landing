---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { program, theme } = variant;
---

<section id="program" class="px-5 py-20 sm:px-8 sm:py-24">
	<div class="mx-auto max-w-[1400px]">
		<div class="grid gap-8 lg:grid-cols-[10rem_1fr] lg:gap-20">
			<p class="eyebrow shrink-0 text-ink-muted lg:pt-5">Why this program</p>

			<div>
				<h2 class="max-w-2xl font-editorial text-section leading-[1.15] text-balance text-ink">
					{program.title}
				</h2>

				<!-- Numbered rules rather than bullets: reads as a considered argument
					 instead of a feature list. Numerals set large in the serif so they
					 carry weight against the statements. -->
				<ol class={`mt-10 border-t ${theme.rule}`}>
					{
						program.bullets.map((bullet, i) => (
							<li class={`reveal border-b ${theme.rule} group`}>
								<div class="flex items-baseline gap-6 py-7 transition-transform duration-300 group-hover:translate-x-1.5 sm:gap-10">
									<span class="shrink-0 font-editorial text-2xl text-crimson tabular-nums sm:text-3xl">
										{String(i + 1).padStart(2, "0")}
									</span>
									<p class="max-w-2xl text-lg leading-snug text-ink sm:text-[1.375rem]">{bullet}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</div>
</section>
