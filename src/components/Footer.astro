---
const year = new Date().getFullYear();
---

<footer class="bg-ink px-5 pb-14 sm:px-8">
	<div class="mx-auto max-w-[1400px] border-t border-white/12 pt-10">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-center gap-3.5">
				<span
					class="grid h-9 w-9 shrink-0 place-items-center bg-crimson font-editorial text-xl leading-none text-white"
					aria-hidden="true">H</span
				>
				<p class="text-sm text-white/55">
					MS/MBA: Engineering Sciences — Harvard Business School × SEAS
				</p>
			</div>
			<p class="text-sm text-white/35">© {year}</p>
		</div>
	</div>
</footer>
