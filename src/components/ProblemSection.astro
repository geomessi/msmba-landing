---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { problem, theme } = variant;
---

<!-- "Make them feel seen before you sell." Set as a full-width editorial
	 statement on the ink ground — a deliberate tonal drop before the pitch.
	 The headline runs wide rather than sitting in a narrow column, so the
	 section reads as a held beat instead of a half-empty grid. -->
<section class={`border-t ${theme.rule} relative overflow-hidden bg-ink px-5 py-24 sm:px-8`}>
	<!-- Soft crimson bloom off the right edge. Blurred rather than a hard-edged
		 shape, which read as a seam across the navy. -->
	<div
		class="pointer-events-none absolute top-1/2 -right-24 h-[120%] w-[38%] -translate-y-1/2 rotate-[14deg] bg-crimson/25 blur-[90px]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-[1400px]">
		<p class="eyebrow flex items-center gap-3 text-white/40">
			<span class="h-px w-8 bg-white/25" aria-hidden="true"></span>
			The tension
		</p>

		<div class="reveal mt-10 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
			<h2 class="font-editorial text-[clamp(2rem,4.6vw,3.75rem)] leading-[1.06] text-balance text-white">
				{problem.title}
			</h2>
			<p class="max-w-xl text-lg leading-relaxed text-white/65 lg:pt-3 lg:text-xl">
				{problem.body}
			</p>
		</div>
	</div>
</section>
