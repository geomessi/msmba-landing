---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { problem, theme } = variant;
---

<!-- "Make them feel seen before you sell." A full-width editorial statement on
	 the ink ground, a deliberate tonal drop before the pitch. The headline runs
	 wide rather than sitting in a narrow column, so the section reads as a held
	 beat instead of a half-empty grid. -->
<section class={`border-t ${theme.rule} relative overflow-hidden bg-ink px-5 py-24 sm:px-8`}>
	<!-- Slow drifting colour wash. Blurred and low-opacity so it reads as light
		 in the room rather than a shape on top of the type. -->
	<div class="aurora pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>

	<!-- A hairline that travels the top edge, tying the dark sections together -->
	<span
		class="rule-glide pointer-events-none absolute inset-x-0 top-0 h-0.5"
		aria-hidden="true"></span>

	<!-- No eyebrow label here on purpose: "The tension" was internal PRD framing,
		 and the dark ground already marks this as its own beat. -->
	<div class="relative mx-auto max-w-[1400px]">
		<div class="reveal grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
			<h2 class="font-editorial text-[clamp(2rem,4.6vw,3.75rem)] leading-[1.06] text-balance text-white">
				{problem.title}
			</h2>
			<p class="max-w-xl text-lg leading-relaxed text-white/65 lg:pt-3 lg:text-xl">
				{problem.body}
			</p>
		</div>
	</div>
</section>
