---
import { PROGRAM_SNAPSHOT } from "../data/content";
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme } = variant;

const facts = [
	{ label: "Cohort size", value: PROGRAM_SNAPSHOT.cohortSize },
	{ label: "Duration", value: PROGRAM_SNAPSHOT.duration },
	{ label: "Degrees conferred", value: PROGRAM_SNAPSHOT.degrees },
	{ label: "Application timing", value: PROGRAM_SNAPSHOT.applicationTiming },
];
---

<section class="bg-black/[0.03] px-6 py-16 sm:py-20">
	<div class="mx-auto max-w-3xl">
		<h2 class={`${theme.headingFont} text-2xl font-bold sm:text-3xl`}>Program Snapshot</h2>
		<dl class="mt-8 grid gap-6 sm:grid-cols-2">
			{
				facts.map((fact) => (
					<div class="rounded-lg bg-white p-5 shadow-sm">
						<dt class="text-sm font-semibold text-black/50 uppercase">{fact.label}</dt>
						<dd class="mt-1 text-black/80">{fact.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
