---
import { PROGRAM_SNAPSHOT, PROGRAM_STATS } from "../data/content";
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme } = variant;
---

<section class={`border-t ${theme.rule} px-5 py-20 sm:px-8 sm:py-24`} aria-label="Program snapshot">
	<div class="mx-auto max-w-[1400px]">
		<p class="eyebrow text-ink-muted">Program snapshot</p>

		<!-- Oversized numerals: the facts do the talking -->
		<dl class={`mt-10 grid divide-y ${theme.rule} border-y ${theme.rule} sm:grid-cols-3 sm:divide-x sm:divide-y-0`}>
			{
				PROGRAM_STATS.map((stat) => (
					<div class="reveal px-0 py-9 sm:px-9 sm:first:pl-0 sm:last:pr-0">
						<dd class="flex items-baseline gap-2">
							<span class="font-display text-6xl font-extrabold tracking-[-0.04em] text-ink tabular-nums sm:text-7xl">
								{stat.value}
							</span>
							{stat.unit && (
								<span class="font-editorial text-2xl text-crimson italic">{stat.unit}</span>
							)}
						</dd>
						<dt class="mt-3 text-ink-soft">{stat.label}</dt>
					</div>
				))
			}
		</dl>

		<!-- Full prose kept on the page for AEO: crawlers and chatbots read these -->
		<div class="mt-10 grid gap-x-16 gap-y-6 sm:grid-cols-2">
			<p class="text-ink-soft">
				<span class="font-bold text-ink">Degrees conferred.</span> {PROGRAM_SNAPSHOT.degrees}
			</p>
			<p class="text-ink-soft">
				<span class="font-bold text-ink">Application timing.</span> {
					PROGRAM_SNAPSHOT.applicationTiming
				}
			</p>
		</div>
	</div>
</section>
