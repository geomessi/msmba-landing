---
import { PROGRAM_STATS } from "../data/content";
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme } = variant;
---

<!-- The prose restatement of degrees and deadlines used to live here. It was
	 redundant against the FAQ, which covers the same ground in the format an
	 answer engine actually quotes. -->
<section
	class={`rule-glide border-t ${theme.rule} px-5 py-20 sm:px-8 sm:py-24`}
	aria-label="Program snapshot"
>
	<div class="mx-auto max-w-[1400px]">
		<p class="eyebrow text-ink-muted">Program snapshot</p>

		<dl
			class={`mt-10 grid divide-y ${theme.rule} border-y ${theme.rule} sm:grid-cols-3 sm:divide-x sm:divide-y-0`}
		>
			{
				PROGRAM_STATS.map((stat) => (
					<div class="reveal group px-0 py-9 sm:px-9 sm:first:pl-0 sm:last:pr-0">
						<dd class="flex items-baseline gap-2">
							{/* The real value is in the DOM first; the count-up only replaces
							    it once it scrolls into view, and never runs with motion off. */}
							<span
								data-count={stat.value}
								class="font-display text-6xl font-extrabold tracking-[-0.04em] text-ink tabular-nums transition-colors duration-500 group-hover:text-crimson sm:text-7xl"
							>
								{stat.value}
							</span>
							{stat.unit && (
								<span class="font-editorial text-2xl text-crimson italic">{stat.unit}</span>
							)}
						</dd>
						<dt class="mt-3 text-ink-soft">{stat.label}</dt>
					</div>
				))
			}
		</dl>
	</div>
</section>

<script>
	import { countUp } from "../lib/interactions";
	document.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
</script>
