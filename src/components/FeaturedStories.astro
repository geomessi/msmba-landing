---
import type { Story, Variant } from "../data/content";

interface Props {
	stories: Story[];
	variant: Variant;
}

const { stories, variant } = Astro.props;
const { theme } = variant;
---

<!-- Linked straight out to the school rather than paraphrased, so this audience can
	 verify the outcomes themselves. -->
<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
	{
		stories.map((story) => (
			<a
				href={story.href}
				target="_blank"
				rel="noopener"
				class={`reveal group flex flex-col border-t-2 border-ink pt-5 transition-transform duration-300 hover:-translate-y-1`}
			>
				<span class="eyebrow text-ink-muted">{story.date}</span>

				<h3 class="mt-3 font-display text-lg leading-snug font-bold text-balance text-ink">
					{story.title}
				</h3>

				<p class="mt-3 flex-1 leading-relaxed text-ink-soft">{story.summary}</p>

				{/* Dot separators: without them the tags ran together into one
				    unreadable string of small caps. */}
				<ul class={`mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 border-t ${theme.rule} pt-4`}>
					{story.tags.map((tag, i) => (
						<li class="flex items-center gap-2">
							{i > 0 && (
								<span class="h-1 w-1 rounded-full bg-crimson/40" aria-hidden="true" />
							)}
							<span class="eyebrow text-crimson">{tag}</span>
						</li>
					))}
				</ul>

				<span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-ink">
					<span class="link-underline">Read more</span>
					<span
						class="text-crimson transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						aria-hidden="true"
					>
						↗
					</span>
				</span>
			</a>
		))
	}
</div>
