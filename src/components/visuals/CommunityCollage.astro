---
// ICP C. A live community rather than a stack of cards.
//
// Three orbit rings turn at different speeds around a warm core, with nodes
// riding each ring. It reads as a small network in motion, which is what the
// cohort actually is, and it avoids both the card-stack cliché and any visual
// that would reduce the women here to a symbol.
const rings = [
	{ r: 132, nodes: 5, cls: "orbit", dur: "46s" },
	{ r: 96, nodes: 4, cls: "orbit-reverse", dur: "34s" },
	{ r: 58, nodes: 3, cls: "orbit", dur: "24s" },
];

const pointsOn = (r: number, count: number) =>
	Array.from({ length: count }, (_, i) => {
		const a = (i / count) * Math.PI * 2 - Math.PI / 2;
		return { x: 200 + r * Math.cos(a), y: 150 + r * Math.sin(a) * 0.72 };
	});
---

<div class="relative aspect-[4/3] w-full">
	<svg
		viewBox="0 0 400 300"
		fill="none"
		class="h-full w-full"
		role="img"
		aria-label="A network of connected nodes orbiting a shared centre, representing the cohort community"
	>
		<defs>
			<radialGradient id="cc-core">
				<stop offset="0%" stop-color="#a51c30" stop-opacity="0.55" />
				<stop offset="100%" stop-color="#a51c30" stop-opacity="0" />
			</radialGradient>
			<linearGradient id="cc-ring" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#a51c30" stop-opacity="0.55" />
				<stop offset="55%" stop-color="#c8102e" stop-opacity="0.2" />
				<stop offset="100%" stop-color="#16243d" stop-opacity="0.35" />
			</linearGradient>
		</defs>

		<circle cx="200" cy="150" r="120" fill="url(#cc-core)" />

		{
			rings.map((ring, ri) => (
				<g class={ring.cls} style={`animation-duration:${ring.dur}; transform-origin:200px 150px`}>
					<ellipse
						cx="200"
						cy="150"
						rx={ring.r}
						ry={ring.r * 0.72}
						stroke="url(#cc-ring)"
						stroke-width="1.25"
						stroke-dasharray="3 7"
					/>
					{pointsOn(ring.r, ring.nodes).map((p, i) => (
						<g>
							<circle
								cx={p.x}
								cy={p.y}
								r="9"
                				fill="#a51c30"
								opacity="0.16"
								class="pulse-halo"
								style={`animation-delay:${(ri * 3 + i) * 380}ms`}
							/>
							<circle
								cx={p.x}
								cy={p.y}
								r={i === 0 ? 6 : 4.5}
								fill={i % 3 === 0 ? "#a51c30" : i % 3 === 1 ? "#16243d" : "#c8102e"}
								class="pulse-node"
								style={`animation-delay:${(ri * 2 + i) * 300}ms`}
							/>
						</g>
					))}
				</g>
			))
		}

		<!-- Shared centre -->
		<circle cx="200" cy="150" r="40" fill="#a51c30" opacity="0.12" class="pulse-halo" />
		<circle cx="200" cy="150" r="30" fill="#fff" stroke="#a51c30" stroke-width="2" />
		<text
			x="200"
			y="148"
			text-anchor="middle"
			class="fill-crimson"
			style="font-size:11px; font-weight:800; letter-spacing:-0.01em"
		>
			MS/MBA
		</text>
		<text
			x="200"
			y="160"
			text-anchor="middle"
			class="fill-ink-muted"
			style="font-size:7px; letter-spacing:0.16em; font-weight:600"
		>
			COHORT
		</text>
	</svg>

	<!-- A single line of student voice, anchored over the network -->
	<figure
		class="absolute right-[2%] bottom-[2%] w-[54%] rotate-[1.5deg] bg-ink px-[4.4cqw] py-[3.6cqw] text-white shadow-[0_30px_66px_-24px_rgba(22,36,61,0.6)]"
	>
		<p class="font-editorial text-[clamp(0.85rem,3.6cqw,1.5rem)] leading-[1.25] text-balance italic">
			“I found the courage to go all in.”
		</p>
		<figcaption
			class="mt-[2.4cqw] text-[clamp(0.45rem,1.6cqw,0.6875rem)] font-semibold tracking-[0.18em] text-white/45 uppercase"
		>
			Current student
		</figcaption>
	</figure>
</div>
