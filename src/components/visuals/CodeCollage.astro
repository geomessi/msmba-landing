---
// ICP B. The terminal is the whole idea, so the floating crimson and navy slabs
// that used to sit behind it are gone: they were decoration that never tied to
// anything. Depth now comes from a second window stacked behind the first and a
// soft gradient bloom, which belong to the same object rather than orbiting it.
---

<div class="relative aspect-[4/3] w-full">
	<!-- Bloom, sitting under everything -->
	<div
		class="pointer-events-none absolute top-[18%] left-[8%] h-[64%] w-[84%] rounded-[40%] bg-gradient-to-br from-crimson/25 via-crimson/10 to-ink/25 blur-[60px]"
		aria-hidden="true"
	>
	</div>

	<!-- Window behind, offset for depth. Kept dark enough to read as a second
		 window rather than a grey slab, with ghosted code lines inside. -->
	<div
		class="absolute top-[14%] left-[24%] h-[48%] w-[70%] rotate-[3.5deg] overflow-hidden rounded-lg bg-[#1b2b45] opacity-80 shadow-[0_18px_44px_-22px_rgba(22,36,61,0.55)]"
		aria-hidden="true"
	>
		<div class="flex gap-[1cqw] bg-white/[0.05] px-[2.6cqw] py-[1.7cqw]">
			<span class="aspect-square w-[1.5cqw] rounded-full bg-white/20"></span>
			<span class="aspect-square w-[1.5cqw] rounded-full bg-white/20"></span>
			<span class="aspect-square w-[1.5cqw] rounded-full bg-white/20"></span>
		</div>
		<div class="space-y-[1.6cqw] px-[3cqw] pt-[2.4cqw]">
			<span class="block h-[1.1cqw] w-[42%] rounded-full bg-white/12"></span>
			<span class="block h-[1.1cqw] w-[58%] rounded-full bg-white/10"></span>
			<span class="block h-[1.1cqw] w-[34%] rounded-full bg-white/[0.07]"></span>
		</div>
	</div>

	<!-- Front window -->
	<figure
		class="absolute top-[27%] left-[8%] w-[76%] -rotate-[2deg] overflow-hidden rounded-lg bg-[#0f1b2e] shadow-[0_30px_70px_-22px_rgba(22,36,61,0.65)]"
	>
		<div class="flex items-center gap-[1.6cqw] bg-white/[0.07] px-[2.6cqw] py-[1.7cqw]">
			<span class="flex gap-[1cqw]" aria-hidden="true">
				<span class="aspect-square w-[1.5cqw] rounded-full bg-white/25"></span>
				<span class="aspect-square w-[1.5cqw] rounded-full bg-white/25"></span>
				<span class="aspect-square w-[1.5cqw] rounded-full bg-white/25"></span>
			</span>
			<figcaption
				class="font-mono text-[clamp(0.5rem,1.55cqw,0.6875rem)] tracking-wide text-white/45"
			>
				venture_os / strategy
			</figcaption>
		</div>

		<pre
			class="overflow-hidden px-[3cqw] py-[3.6cqw] font-mono text-[clamp(0.5rem,2cqw,0.9rem)] leading-[2.1]"><code><span class="select-none text-white/25">01  </span><span class="text-[#f692ce]">const</span> <span class="text-[#7dd3fc]">ambition</span> <span class="text-white/55">=</span> <span class="text-[#fdba74]">"founder"</span>
<span class="select-none text-white/25">02  </span><span class="text-[#f692ce]">const</span> <span class="text-[#7dd3fc]">advantage</span> <span class="text-white/55">=</span> <span class="text-[#fdba74]">"technical"</span>
<span class="select-none text-white/25">03  </span>
<span class="select-none text-white/25">04  </span><span class="text-[#f692ce]">return</span> <span class="text-[#7dd3fc]">build</span><span class="text-white/55">(</span><span class="text-[#a5f3c0]">future</span><span class="text-white/55">)</span>
<span class="select-none text-white/25">05  </span><span class="caret text-white/70">_</span></code></pre>

		<!-- Scanline drifting down the window -->
		<span
			class="scan pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-transparent via-white/[0.045] to-transparent"
			aria-hidden="true"></span>
	</figure>
</div>

<style>
	.caret {
		animation: blink 1.2s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.scan {
		animation: scan 6.5s ease-in-out infinite;
	}

	@keyframes scan {
		0% {
			transform: translateY(-100%);
			opacity: 0;
		}
		12%,
		68% {
			opacity: 1;
		}
		100% {
			transform: translateY(520%);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret,
		.scan {
			animation: none;
		}
		.scan {
			opacity: 0;
		}
	}
</style>
