---
// ICP A — authoritative, institutional. The two conferred credentials shown as
// stacked cards: the dual-degree signal is the whole argument for this ICP.
// Deliberately no code and no startup aesthetic (PRD: "trusts legacy brands").
//
// All type is sized in cqw so the composition scales proportionally with the
// panel; at mobile widths fixed sizes collided and overlapped.
const credentials = [
	{ degree: "MS", school: "Engineering Sciences, SEAS", meta: "Two years" },
	{ degree: "MBA", school: "Harvard Business School", meta: "Cohort of 30" },
];
---

<div class="relative aspect-[4/3] w-full">
	<!-- Back card: the MS from SEAS -->
	<article
		class="absolute top-[8%] left-[8%] w-[70%] rotate-[-4deg] border border-rule bg-white px-[5cqw] py-[4cqw] shadow-[0_24px_60px_-26px_rgba(22,36,61,0.4)]"
	>
		<p
			class="text-[clamp(0.5rem,1.7cqw,0.6875rem)] font-semibold tracking-[0.18em] text-ink-muted uppercase"
		>
			Conferred by
		</p>
		<p class="mt-[1.5cqw] font-editorial text-[clamp(0.95rem,5cqw,1.875rem)] leading-tight text-ink">
			{credentials[0].school}
		</p>
		<div class="mt-[3cqw] flex items-baseline justify-between gap-3 border-t border-rule pt-[2.5cqw]">
			<span
				class="font-display text-[clamp(1.5rem,8.5cqw,3rem)] leading-none font-extrabold tracking-tight text-ink"
			>
				{credentials[0].degree}
			</span>
			<span
				class="text-[clamp(0.5rem,1.7cqw,0.6875rem)] font-semibold tracking-[0.18em] whitespace-nowrap text-ink-muted uppercase"
			>
				{credentials[0].meta}
			</span>
		</div>
	</article>

	<!-- Front card: the MBA from HBS, crimson-weighted -->
	<article
		class="absolute right-[5%] bottom-[8%] w-[70%] rotate-[3deg] border border-rule bg-white px-[5cqw] py-[4cqw] shadow-[0_30px_70px_-24px_rgba(22,36,61,0.45)]"
	>
		<p
			class="text-[clamp(0.5rem,1.7cqw,0.6875rem)] font-semibold tracking-[0.18em] text-crimson uppercase"
		>
			Conferred by
		</p>
		<p class="mt-[1.5cqw] font-editorial text-[clamp(0.95rem,5cqw,1.875rem)] leading-tight text-ink">
			{credentials[1].school}
		</p>
		<div class="mt-[3cqw] flex items-baseline justify-between gap-3 border-t border-rule pt-[2.5cqw]">
			<span
				class="font-display text-[clamp(1.5rem,8.5cqw,3rem)] leading-none font-extrabold tracking-tight text-crimson"
			>
				{credentials[1].degree}
			</span>
			<span
				class="text-[clamp(0.5rem,1.7cqw,0.6875rem)] font-semibold tracking-[0.18em] whitespace-nowrap text-ink-muted uppercase"
			>
				{credentials[1].meta}
			</span>
		</div>
	</article>

	<!-- Hairline connector implying the two are one path -->
	<svg
		class="pointer-events-none absolute inset-0 h-full w-full text-crimson/35"
		viewBox="0 0 400 300"
		fill="none"
		aria-hidden="true"
	>
		<path d="M150 128 C 200 150, 210 160, 262 182" stroke="currentColor" stroke-dasharray="4 5" />
	</svg>
</div>
