---
// Shell for the standing pages (about, privacy). Deliberately simpler than the
// variant chrome: the full nav's CTA points at an on-page waitlist anchor that
// does not exist here, so this carries just the lockup and a way back.
interface Props {
	eyebrow: string;
	title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="rule-glide border-b border-rule bg-paper/85 backdrop-blur-md">
	<div class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-5 py-4 sm:px-8">
		<a href="/" class="flex items-center gap-3.5">
			<span
				class="grid h-11 w-11 shrink-0 place-items-center bg-crimson font-editorial text-2xl leading-none text-white"
				aria-hidden="true">H</span
			>
			<span class="flex flex-col leading-none">
				<span class="text-xl font-bold tracking-tight text-ink">MS/MBA</span>
				<span class="eyebrow mt-1 hidden whitespace-nowrap text-ink-muted sm:block">
					Engineering Sciences
				</span>
			</span>
		</a>
		<a
			href="/"
			class="group flex items-center gap-1.5 text-sm font-bold text-ink sm:text-[0.9375rem]"
		>
			<span class="link-underline">Back to the overview</span>
			<span class="text-crimson transition-transform duration-300 group-hover:-translate-x-0.5"
				>←</span
			>
		</a>
	</div>
</header>

<main class="mx-auto max-w-2xl px-5 py-20 sm:px-8 sm:py-24">
	<p class="eyebrow text-crimson">{eyebrow}</p>
	<h1 class="mt-6 font-editorial text-section leading-tight text-balance text-ink">{title}</h1>

	<div class="prose-body mt-10">
		<slot />
	</div>
</main>

<style>
	.prose-body :global(h2) {
		font-family: var(--font-editorial);
		font-size: 1.5rem;
		line-height: 1.25;
		color: var(--color-ink);
		margin-top: 2.75rem;
		margin-bottom: 0.75rem;
	}

	.prose-body :global(p) {
		color: var(--color-ink-soft);
		line-height: 1.7;
		margin-bottom: 1.1rem;
	}

	.prose-body :global(ul) {
		margin-bottom: 1.1rem;
		padding-left: 0;
		list-style: none;
	}

	.prose-body :global(li) {
		color: var(--color-ink-soft);
		line-height: 1.7;
		padding-left: 1.5rem;
		position: relative;
		margin-bottom: 0.5rem;
	}

	.prose-body :global(li)::before {
		content: "—";
		position: absolute;
		left: 0;
		color: var(--color-crimson);
	}

	.prose-body :global(a) {
		color: var(--color-crimson);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose-body :global(strong) {
		color: var(--color-ink);
		font-weight: 600;
	}
</style>
