---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
	placement: "hero" | "cta";
}

const { variant, placement } = Astro.props;
const { hero } = variant;
const formId = `waitlist-${variant.slug}-${placement}`;
---

<div class="w-full max-w-lg">
	<form
		id={formId}
		class="group flex flex-col gap-3 sm:flex-row sm:items-stretch"
		data-variant={variant.slug}
		data-cta-kind={hero.ctaKind}
		novalidate
	>
		<label class="sr-only" for={`${formId}-email`}>Email address</label>
		<input
			id={`${formId}-email`}
			name="email"
			type="email"
			required
			autocomplete="email"
			placeholder="you@email.com"
			class="w-full border-b-2 border-white/25 bg-transparent px-0 py-3.5 text-lg text-white transition-colors duration-300 placeholder:text-white/35 focus:border-white focus:outline-none"
		/>
		<button
			type="submit"
			class="btn-primary group/btn inline-flex shrink-0 items-center justify-center gap-2.5 bg-white px-7 py-4 text-[0.9375rem] font-bold !text-ink"
		>
			<span class="submit-label">{hero.ctaLabel}</span>
			<span
				class="transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
				aria-hidden="true">↗</span
			>
		</button>
	</form>

	<p class="form-status mt-4 min-h-6 text-sm text-white/60" role="status" aria-live="polite"></p>
</div>

<script>
	import { track } from "../lib/track";

	function utmParams(): Record<string, string> {
		const params = new URLSearchParams(window.location.search);
		const out: Record<string, string> = {};
		for (const key of ["utm_source", "utm_medium", "utm_campaign"]) {
			const value = params.get(key);
			if (value) out[key] = value;
		}
		return out;
	}

	document.querySelectorAll<HTMLFormElement>("form[data-variant]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const status = form.parentElement?.querySelector<HTMLParagraphElement>(".form-status");
			const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const label = form.querySelector<HTMLSpanElement>(".submit-label");
			const email = emailInput?.value.trim() ?? "";
			const variant = form.dataset.variant ?? "";
			const ctaKind = form.dataset.ctaKind ?? "waitlist";

			if (!emailInput?.checkValidity()) {
				if (status) status.textContent = "That email address does not look right. Mind checking it?";
				emailInput?.focus();
				return;
			}

			const originalLabel = label?.textContent ?? "";
			if (submitButton) submitButton.disabled = true;
			if (label) label.textContent = "Sending…";
			if (status) status.textContent = "";

			try {
				const response = await fetch("/api/waitlist", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, variant, ctaKind, utm: utmParams() }),
				});

				if (!response.ok) throw new Error("request_failed");

				track(ctaKind === "info-session" ? "info_session_click" : "waitlist_signup", { variant });

				if (status) status.textContent = "You are on the list. Check your email for confirmation.";
				if (label) label.textContent = "Done";
				form.reset();
				// Leave the confirmed state visible rather than snapping back.
				window.setTimeout(() => {
					if (label) label.textContent = originalLabel;
					if (submitButton) submitButton.disabled = false;
				}, 2400);
			} catch {
				if (status) status.textContent = "Something went wrong. Please try again.";
				if (label) label.textContent = originalLabel;
				if (submitButton) submitButton.disabled = false;
			}
		});
	});
</script>
