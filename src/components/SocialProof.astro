---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { theme, socialProof, communityAssets } = variant;
---

<section class="px-6 py-16 sm:py-20">
	<div class="mx-auto max-w-3xl">
		<h2 class={`${theme.headingFont} text-2xl font-bold sm:text-3xl`}>{socialProof.title}</h2>
		<div class="mt-8 grid gap-6 sm:grid-cols-2">
			{
				socialProof.quotes.map((item) => (
					<blockquote
						class={`rounded-lg border p-6 ${item.isPlaceholder ? "border-dashed border-black/20 bg-amber-50" : "border-black/10 bg-white"}`}
					>
						<p class="text-black/80 italic">"{item.quote}"</p>
						<footer class="mt-3 text-sm font-medium text-black/50">{item.attribution}</footer>
					</blockquote>
				))
			}
		</div>

		{
			communityAssets && communityAssets.length > 0 && (
				<div class="mt-10 rounded-lg border border-dashed border-black/20 bg-amber-50 p-6">
					<p class="text-sm font-semibold text-black/60 uppercase">
						Community assets — confirm before launch
					</p>
					<ul class="mt-3 list-disc space-y-1 pl-5 text-black/70">
						{communityAssets.map((asset) => (
							<li>{asset}</li>
						))}
					</ul>
				</div>
			)
		}
	</div>
</section>
