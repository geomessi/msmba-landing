---
import type { Variant } from "../data/content";

interface Props {
	variant: Variant;
}

const { variant } = Astro.props;
const { socialProof, communityAssets, theme } = variant;
---

<section id="outcomes" class={`border-t ${theme.rule} px-5 py-20 sm:px-8 sm:py-24`}>
	<div class="mx-auto max-w-[1400px]">
		<div class="grid gap-8 lg:grid-cols-[10rem_1fr] lg:gap-20">
			<p class="eyebrow shrink-0 text-ink-muted lg:pt-5">Outcomes</p>

			<div>
				<h2 class="max-w-2xl font-editorial text-section leading-[1.15] text-balance text-ink">
					{socialProof.title}
				</h2>

				<div class="mt-10 grid gap-6 sm:grid-cols-2">
					{
						socialProof.quotes.map((item) => (
							<blockquote
								class={`reveal relative flex flex-col justify-between p-8 ${
									item.isPlaceholder
										? "border border-dashed border-crimson/35 bg-crimson/[0.04]"
										: `border ${theme.rule} bg-white shadow-[0_20px_50px_-32px_rgba(22,36,61,0.35)]`
								}`}
							>
								{/* Oversized serif quote mark as a graphic element */}
								<span
									class="pointer-events-none absolute top-3 right-5 font-editorial text-7xl leading-none text-crimson/12 select-none"
									aria-hidden="true"
								>
									”
								</span>
								<p class="relative font-editorial text-2xl leading-snug text-ink">{item.quote}</p>
								<footer class="eyebrow mt-7 text-ink-muted">{item.attribution}</footer>
							</blockquote>
						))
					}
				</div>

				{
					communityAssets && communityAssets.length > 0 && (
						<div class="reveal mt-8 border border-dashed border-crimson/35 bg-crimson/[0.04] p-8">
							<p class="eyebrow text-crimson">Community assets — confirm before launch</p>
							<ul class="mt-5 space-y-3">
								{communityAssets.map((asset) => (
									<li class="flex gap-4 text-ink-soft">
										<span class="text-crimson" aria-hidden="true">
											—
										</span>
										<span>{asset}</span>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</div>
	</div>
</section>
