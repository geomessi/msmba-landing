---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	bodyClass?: string;
	noindex?: boolean;
}

const { title, description, bodyClass = "", noindex = false } = Astro.props;

// Section 5.4, schema.org markup so AI assistants can cite program facts directly.
const programSchema = {
	"@context": "https://schema.org",
	"@type": "EducationalOccupationalProgram",
	name: "MS/MBA: Engineering Sciences",
	description:
		"A two-year, full-time joint degree from Harvard Business School and the Harvard John A. Paulson School of Engineering and Applied Sciences, for engineers who want to found and lead technology ventures.",
	provider: [
		{ "@type": "CollegeOrUniversity", name: "Harvard Business School" },
		{
			"@type": "CollegeOrUniversity",
			name: "Harvard John A. Paulson School of Engineering and Applied Sciences",
		},
	],
	timeToComplete: "P2Y",
	educationalCredentialAwarded: ["MBA", "MS in Engineering Sciences"],
};

/**
 * Plausible's current install format. The site identity is baked into the
 * script filename rather than passed as a data-domain attribute.
 *
 * Hardcoded rather than held in an env var on purpose: this id is served to
 * every visitor in the page source, so it is public by definition, and keeping
 * it in a gitignored .env would mean analytics silently breaking on any fresh
 * clone or CI build. To point at a different Plausible site, change this line.
 */
const PLAUSIBLE_SRC = "https://plausible.io/js/pa-UmzFPIc0xDhjnphpEiS1O.js";

const SITE = "https://aifounder-msmba.aifounder-msmba.workers.dev";
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, "") || SITE;
const ogImage = `${SITE}/og.png`;

// A markdown twin exists for the variant pages and the root, so advertise it.
const mdPath =
	Astro.url.pathname === "/" ? "/index.md" : `${Astro.url.pathname.replace(/\/$/, "")}.md`;
const hasMarkdown = ["/", "/parent", "/swe", "/women-in-tech"].includes(
	Astro.url.pathname.replace(/\/$/, "") || "/",
);

/**
 * Identity schema. The scan found structured data but no entity type, so an
 * agent could read the program facts without resolving who is behind them.
 *
 * sameAs points at the real Harvard properties on purpose: this is an
 * independent student site, and the right outcome is an agent resolving the
 * program to Harvard rather than mistaking this domain for an official one.
 * No phone number or email is invented here for the same reason.
 */
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "EducationalOrganization",
	"@id": `${SITE}/#organization`,
	name: "Harvard MS/MBA: Engineering Sciences",
	alternateName: "MS/MBA Engineering Sciences",
	url: SITE,
	description:
		"A two-year joint degree from Harvard Business School and the Harvard John A. Paulson School of Engineering and Applied Sciences.",
	parentOrganization: { "@type": "CollegeOrUniversity", name: "Harvard University", url: "https://www.harvard.edu/" },
	address: {
		"@type": "PostalAddress",
		streetAddress: "Soldiers Field",
		addressLocality: "Boston",
		addressRegion: "MA",
		postalCode: "02163",
		addressCountry: "US",
	},
	contactPoint: {
		"@type": "ContactPoint",
		contactType: "admissions",
		url: "https://www.hbs.edu/mba/admissions/Pages/default.aspx",
		areaServed: "Worldwide",
		availableLanguage: "English",
	},
	sameAs: ["https://www.hbs.edu/", "https://seas.harvard.edu/", "https://www.harvard.edu/"],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}

		{/* Point agents at the plain-text twin of this page. */}
		{hasMarkdown && <link rel="alternate" type="text/markdown" href={mdPath} />}
		<link rel="alternate" type="text/plain" href="/llms.txt" title="Guidance for AI agents" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MS/MBA: Engineering Sciences" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="MS/MBA: Engineering Sciences, Harvard" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(programSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

		{/* Privacy-friendly analytics by Plausible. The inline stub queues any
		    custom event fired before the async script finishes loading, so the
		    waitlist and FAQ events are not lost on a fast interaction. */}
		<script is:inline async src={PLAUSIBLE_SRC}></script>
		<script is:inline>
			window.plausible =
				window.plausible ||
				function () {
					(plausible.q = plausible.q || []).push(arguments);
				};
			plausible.init =
				plausible.init ||
				function (i) {
					plausible.o = i || {};
				};
			plausible.init();
		</script>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
