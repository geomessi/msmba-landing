---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	bodyClass?: string;
	noindex?: boolean;
}

const { title, description, bodyClass = "", noindex = false } = Astro.props;

// Section 5.4, schema.org markup so AI assistants can cite program facts directly.
const programSchema = {
	"@context": "https://schema.org",
	"@type": "EducationalOccupationalProgram",
	name: "MS/MBA: Engineering Sciences",
	description:
		"A two-year, full-time joint degree from Harvard Business School and the Harvard John A. Paulson School of Engineering and Applied Sciences, for engineers who want to found and lead technology ventures.",
	provider: [
		{ "@type": "CollegeOrUniversity", name: "Harvard Business School" },
		{
			"@type": "CollegeOrUniversity",
			name: "Harvard John A. Paulson School of Engineering and Applied Sciences",
		},
	],
	timeToComplete: "P2Y",
	educationalCredentialAwarded: ["MBA", "MS in Engineering Sciences"],
};

/**
 * Plausible's current install format. The site identity is baked into the
 * script filename rather than passed as a data-domain attribute.
 *
 * Hardcoded rather than held in an env var on purpose: this id is served to
 * every visitor in the page source, so it is public by definition, and keeping
 * it in a gitignored .env would mean analytics silently breaking on any fresh
 * clone or CI build. To point at a different Plausible site, change this line.
 */
const PLAUSIBLE_SRC = "https://plausible.io/js/pa-UmzFPIc0xDhjnphpEiS1O.js";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(programSchema)} />

		{/* Privacy-friendly analytics by Plausible. The inline stub queues any
		    custom event fired before the async script finishes loading, so the
		    waitlist and FAQ events are not lost on a fast interaction. */}
		<script is:inline async src={PLAUSIBLE_SRC}></script>
		<script is:inline>
			window.plausible =
				window.plausible ||
				function () {
					(plausible.q = plausible.q || []).push(arguments);
				};
			plausible.init =
				plausible.init ||
				function (i) {
					plausible.o = i || {};
				};
			plausible.init();
		</script>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
