---
import Layout from "../layouts/Layout.astro";
import { VARIANTS } from "../data/content";
---

<Layout
	title="MS/MBA Landing Page Variants — Internal Review"
	description="Internal review index for the three MS/MBA: Engineering Sciences landing page variants."
	noindex
>
	<main class="mx-auto max-w-2xl px-6 py-20">
		<h1 class="text-2xl font-bold">MS/MBA Landing Page Variants</h1>
		<p class="mt-2 text-black/60">Internal review index — not a public-facing page.</p>
		<ul class="mt-8 space-y-4">
			{
				VARIANTS.map((variant) => (
					<li class="rounded-lg border border-black/10 p-5">
						<a href={`/${variant.slug}`} class="text-lg font-semibold underline underline-offset-2">
							{variant.icpLabel}
						</a>
						<p class="mt-1 text-black/60">{variant.hero.headline}</p>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
