---
import Layout from "../layouts/Layout.astro";
import { VARIANTS } from "../data/content";
---

<Layout
	title="MS/MBA Landing Page Variants — Internal Review"
	description="Internal review index for the three MS/MBA: Engineering Sciences landing page variants."
	noindex
	bodyClass="bg-paper"
>
	<main class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
		<p class="eyebrow text-crimson">Internal</p>
		<h1 class="mt-6 font-editorial text-section leading-tight text-ink">
			Landing page variants
		</h1>
		<p class="mt-4 max-w-xl text-lg text-ink-soft">
			Same structure on all three pages, different message on each, so the only thing being tested
			is the copy.
		</p>

		<ul class="mt-14 border-t border-rule">
			{
				VARIANTS.map((variant) => (
					<li class="border-b border-rule">
						<a href={`/${variant.slug}`} class="group flex items-baseline gap-6 py-7 sm:gap-10">
							<span class="eyebrow shrink-0 text-crimson">{variant.icpLabel.split(" — ")[0]}</span>
							<span class="flex-1">
								<span class="block font-editorial text-2xl text-ink transition-transform duration-300 group-hover:translate-x-1">
									{variant.hero.headline}
								</span>
								<span class="mt-1 block text-ink-muted">
									{variant.audience} · {variant.hero.ctaLabel}
								</span>
							</span>
							<span
								class="shrink-0 text-crimson transition-transform duration-300 group-hover:translate-x-1"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
